{
  "name": "smart-student-commute-server",
  "version": "1.0.0",
  "description": "Backend for Smart Student Commute Companion",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "verify:config": "node scripts/verify_config.js",
    "verify:bootstrap": "node scripts/verify_bootstrap.js",
    "verify:routes": "node scripts/verify_routes.js",
    "verify:errors": "node scripts/verify_errors.js",
    "verify:validation": "node scripts/verify_validation.js",
    "test": "node scripts/smoke_test.js",
    "test:db": "node scripts/integration_db_test.js",
    "test:all": "npm run verify:config && npm run verify:bootstrap && npm run verify:routes && npm run verify:errors && npm run verify:validation && npm run test && npm run test:db",
    "db:migrate": "node migrations/cli.js up",
    "db:rollback": "node migrations/cli.js down",
    "db:status": "node migrations/cli.js status"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  }
}
