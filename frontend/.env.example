# Frontend Environment Variables
# Copy this file to .env.local for local development
# Vite exposes variables prefixed with VITE_ to the client bundle

# API Configuration
# Base URL for backend API endpoints (proxied in dev, full URL in production)
VITE_API_BASE_URL=/api

# WebSocket Configuration
# Socket.IO connection URL (proxied in dev, full URL in production)
VITE_SOCKET_URL=/

# App Metadata
VITE_APP_TITLE=Smart Student Commute Companion
VITE_APP_DESCRIPTION=AI-powered student mobility assistant for Mumbai college commutes

# Feature Flags (optional)
# Set to 'true' or 'false' to enable/disable features
VITE_ENABLE_DEMO_RESET=true

# Development Configuration
# Log level for development (error, warn, info, debug)
VITE_LOG_LEVEL=info

# PWA Configuration (optional)
# Enable service worker in development mode (disabled by default to avoid caching issues)
# VITE_SW_DEV=true

# ⚠️ SECURITY NOTES:
# - NEVER put backend secrets, API keys, database credentials, or private keys here
# - All VITE_ variables are exposed in the client bundle (publicly accessible)
# - Only put public configuration values that are safe to expose to users
# - For sensitive values, use backend environment variables instead
